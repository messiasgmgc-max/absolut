# Configurações do Supabase para o Absolut Parfum
# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Dados da Loja Absolut Parfum
NEXT_PUBLIC_STORE_NAME=Absolut Parfum
NEXT_PUBLIC_STORE_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_STORE_PHONE=(11) 99999-9999
NEXT_PUBLIC_STORE_PIX_KEY=contato@absolutparfum.com.br
